<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lab 4 · Step 3：Logback 结构化日志（JSON 格式）

  默认输出 JSON（便于采集到 ELK/Loki）；本地开发可启用 local profile 切换成人类可读格式，
  启动命令见 README「快速开始 · 启动」。

  注意：XML 注释里不能出现两个连续的减号，所以这里不写完整的命令行参数。

  traceId 来自 TraceIdFilter 的 MDC，与错误响应里的 traceId 一致。
-->
<configuration>

    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{traceId:--}] %cyan(%logger{36}) - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdc>true</includeMdc>
                <customFields>{"service":"campus-overflow","env":"${ENV:-local}"}</customFields>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>[ignore]</version>
                </fieldNames>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.campusoverflow" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>
</configuration>
