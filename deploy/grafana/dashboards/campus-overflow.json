{
  "uid": "campus-overflow-main",
  "title": "CampusOverflow · 生产概览",
  "tags": ["campus-overflow", "lab8"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "QPS（每秒请求数）",
      "description": "所有 HTTP 接口的请求速率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"campus-overflow\"}[1m]))",
          "legendFormat": "QPS"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 延迟",
      "description": "SLO：p95 < 500ms",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"campus-overflow\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"campus-overflow\"}[5m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx 错误率",
      "description": "SLO：< 1%",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"campus-overflow\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"campus-overflow\"}[5m])), 0.001)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "JVM 堆使用率",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.75 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"campus-overflow\",area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{job=\"campus-overflow\",area=\"heap\"}), 1)",
          "legendFormat": "heap"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "数据库连接池（HikariCP）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"campus-overflow\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{job=\"campus-overflow\"}",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{job=\"campus-overflow\"}",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "业务指标（每分钟）",
      "description": "提问 / 回答 / 采纳 / 投票 / 评论",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(campusoverflow_questions_posted_total{job=\"campus-overflow\"}[5m])) * 60",
          "legendFormat": "提问"
        },
        {
          "refId": "B",
          "expr": "sum(rate(campusoverflow_answers_submitted_total{job=\"campus-overflow\"}[5m])) * 60",
          "legendFormat": "回答"
        },
        {
          "refId": "C",
          "expr": "sum(rate(campusoverflow_answers_accepted_total{job=\"campus-overflow\"}[5m])) * 60",
          "legendFormat": "采纳"
        },
        {
          "refId": "D",
          "expr": "sum(rate(campusoverflow_votes_cast_total{job=\"campus-overflow\"}[5m])) * 60",
          "legendFormat": "投票"
        },
        {
          "refId": "E",
          "expr": "sum(rate(campusoverflow_comments_posted_total{job=\"campus-overflow\"}[5m])) * 60",
          "legendFormat": "评论"
        }
      ]
    }
  ]
}
