<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.campusoverflow</groupId>
    <artifactId>campus-overflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>CampusOverflow Backend</name>
    <description>校园问答社区 CampusOverflow 后端：按 DDD 限界上下文物理分包的多模块 Maven 工程（Lab 4）</description>

    <modules>
        <module>co-shared-kernel</module>
        <module>co-identity</module>
        <module>co-qa</module>
        <module>co-reputation</module>
        <module>co-discovery</module>
        <module>co-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>3.5.6</spring-boot.version>
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 统一第三方依赖版本：Spring Boot BOM（Spring Boot 3.5 / JDK 21 / JUnit 5） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <!-- 内部模块版本由父 POM 统一管理，子模块引用时不再写 version -->
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!--
                      jdk.attach.allowAttachSelf：Mockito 的 inline mock maker 需要自附加 agent。
                      不加这个参数时 ByteBuddy 会退化成"另起一个 JVM 进程去 attach"，
                      在没有进程创建权限的环境（容器、受限沙箱、部分 CI）里会直接失败。
                    -->
                    <argLine>-Dfile.encoding=UTF-8 -Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
