# ============================================================================
# 复制为 .env 后修改；.env 已在 .gitignore 中，绝不提交真实密码
#   cp .env.example .env
# ============================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=campus_overflow
MYSQL_USER=campus
MYSQL_PASSWORD=change-me-app

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# 通过 SSH 隧道访问时保持 localhost 即可
GRAFANA_ROOT_URL=http://localhost:3000

# ---- 端口 ----
HTTP_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- 镜像（CI 推送后由部署机拉取；留空则用本地 build）----
APP_IMAGE=campus-overflow/backend:latest
FRONTEND_IMAGE=campus-overflow/frontend:latest

# ---- 运行环境 ----
DEPLOY_ENV=production
TZ=Asia/Shanghai
