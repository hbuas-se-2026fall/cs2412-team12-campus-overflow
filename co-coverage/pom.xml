<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.campusoverflow</groupId>
        <artifactId>campus-overflow</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>co-coverage</artifactId>
    <name>co-coverage</name>
    <description>
        Lab 7 质量门禁专用模块（不参与运行）：聚合所有模块的 JaCoCo 执行数据，
        生成一份整体覆盖率报告 co-coverage/target/site/jacoco-aggregate/jacoco.xml，
        由 tools/coverage-gate.mjs 与 CI 共同校验（整体 ≥70%、核心聚合包 ≥90%）。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-shared-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-qa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-reputation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-bootstrap</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
