              ]
            }
          }
        },
        {
          "name": "03-5 重复邮箱注册 → 409 INV-U-01",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('错误码为 INV-U-01', () => pm.expect(pm.response.json().code).to.eql('INV-U-01'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tao@hbuas.edu.cn\",\n  \"nickname\": \"重复注册\",\n  \"password\": \"abc12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            }
          }
        }
      ]
    }
  ]
}
